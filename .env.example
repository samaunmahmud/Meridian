# Copy to .env and fill in. Used by docker-compose.yml at the repository root.

# --- Database (choose your own passwords)
MYSQL_ROOT_PASSWORD=change_me_root
MYSQL_PASSWORD=change_me
# MYSQL_DATABASE=meridian
# MYSQL_USER=meridian

# --- Session signing key: at least 32 random characters. Generate one with:
#     openssl rand -base64 48
JWT_SECRET=

# --- Prices (see meridian-backend/.env.example for the details)
ALPHA_VANTAGE_API_KEY=
# MARKETDATA_PROVIDER=finnhub
# FINNHUB_API_KEY=
# When the provider is down the site keeps showing the last known prices, but market orders,
# recurring buys and currency conversions refuse a price/rate older than this many minutes
# (0 = worked out from the polling settings: at least 15 / 30 minutes).
# Stocks trade Mon-Fri 09:30-16:00 New York time (not on exchange holidays); a market order placed while the
# market is closed waits for the open. Crypto is always open. Set to false to trade stocks at any hour.
# MARKET_HOURS_ENFORCED=true
# MARKETDATA_MAX_PRICE_AGE_MINUTES=0
# MARKETDATA_MAX_FX_RATE_AGE_MINUTES=0

# --- Email (password reset and address confirmation)
# Any SMTP server works (your provider's, Amazon SES, Mailgun, ...). If MAIL_HOST is
# left empty the emails are only printed in the backend log, so nobody receives them.
# MAIL_HOST=smtp.example.com
# MAIL_PORT=587
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_STARTTLS=true
# MAIL_FROM=Meridian <noreply@example.com>

# --- Where the site is served
# The address people use in the browser. Must match exactly (scheme + host [+ port]).
# PUBLIC_URL=https://app.example.com
# Set to true once the site is served over HTTPS, so the session cookie is HTTPS-only.
# AUTH_COOKIE_SECURE=true
# Host port for the site (default 80).
# WEB_PORT=8181
