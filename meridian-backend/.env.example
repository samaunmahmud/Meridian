MYSQL_ROOT_PASSWORD=changeme_root
MYSQL_USER=meridian
MYSQL_PASSWORD=changeme
MYSQL_DATABASE=meridian
ALPHA_VANTAGE_API_KEY=your_key_here
JWT_SECRET=your_generated_secret_here

# --- Optional: price provider ---
# Alpha Vantage's free plan allows only ~25 requests a day, so prices refresh
# roughly every 1.5 hours. For live-ish prices use Finnhub (free key at
# finnhub.io, ~60 calls/minute): set MARKETDATA_PROVIDER=finnhub and FINNHUB_API_KEY.
# MARKETDATA_PROVIDER=alphavantage
# FINNHUB_API_KEY=your_finnhub_key
# On a paid plan, raise the daily allowance the app will use:
# MARKETDATA_DAILY_REQUEST_BUDGET=25

# --- Email (password reset and address confirmation) ---
# Leave MAIL_HOST empty in development: emails are then printed in the backend log,
# where you can copy the link. Set these to send real emails over SMTP.
# MAIL_HOST=smtp.example.com
# MAIL_PORT=587
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_STARTTLS=true
# MAIL_FROM=Meridian <noreply@example.com>
# The address people use in the browser; links in emails point here.
# PUBLIC_URL=http://localhost:5173

# --- Production: serving the site over HTTPS ---
# Your site's address(es), comma-separated, and secure-only session cookies:
# CORS_ALLOWED_ORIGINS=https://app.example.com
# AUTH_COOKIE_SECURE=true
