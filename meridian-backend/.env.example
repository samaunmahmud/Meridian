MYSQL_ROOT_PASSWORD=changeme_root
MYSQL_USER=meridian
MYSQL_PASSWORD=changeme
MYSQL_DATABASE=meridian
ALPHA_VANTAGE_API_KEY=your_key_here
JWT_SECRET=your_generated_secret_here

# --- Optional: price provider ---
# Alpha Vantage's free plan allows only ~25 requests a day, so prices refresh
# roughly every 1.5 hours. For live-ish prices use Finnhub (free key at
# finnhub.io, ~60 calls/minute): set MARKETDATA_PROVIDER=finnhub and FINNHUB_API_KEY.
# MARKETDATA_PROVIDER=alphavantage
# FINNHUB_API_KEY=your_finnhub_key
# On a paid plan, raise the daily allowance the app will use:
# MARKETDATA_DAILY_REQUEST_BUDGET=25
